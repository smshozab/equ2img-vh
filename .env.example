# LLM provider: "gateway" (Vercel AI Gateway, default), "gemini", or "openai"
LLM_PROVIDER=gateway

# --- Vercel AI Gateway (default; OpenAI-compatible API) ---
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_GATEWAY_MODEL=openai/gpt-4o-mini

# --- Google Gemini ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Repair loop retries (default 3)
MAX_REPAIR_ATTEMPTS=3
